{
  "name": "creature",
  "version": "0.1.0",
  "description": "Glorp: an autonomous AI creature that lives, makes things, and develops its own hobbies.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js live",
    "watch": "node --env-file-if-exists=.env src/index.js watch",
    "tick": "node --env-file-if-exists=.env src/index.js tick",
    "status": "node --env-file-if-exists=.env src/index.js status",
    "diary": "node --env-file-if-exists=.env src/index.js diary",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "three": "0.170.0",
    "zod": "^4.6.7"
  }
}
