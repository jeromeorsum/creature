# Your Claude API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# How often Glorp wakes up to decide what to do, in minutes
TICK_MINUTES=30

# Glorp stops thinking for the day once it has spent this much (US dollars)
DAILY_BUDGET_USD=1.00

# Glorp sleeps (no AI calls) between these hours, in your timezone
SLEEP_FROM_HOUR=23
SLEEP_UNTIL_HOUR=7
TZ=Europe/London

# Model and thinking effort (low is cheapest)
CREATURE_MODEL=claude-opus-5-5
CREATURE_EFFORT=low

# Set to 1 to run without the AI (random choices), for testing
CREATURE_FAKE=0
