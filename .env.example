# Glorp's brain: use ONE of these.
# Claude subscription token (run `claude setup-token`), needs Claude Code installed
CLAUDE_CODE_OAUTH_TOKEN=
# or a paid Claude API key
ANTHROPIC_API_KEY=

# How often Glorp wakes up to decide what to do, in minutes
TICK_MINUTES=30

# Glorp stops thinking for the day once it has spent this much (US dollars)
DAILY_BUDGET_USD=1.00

# Glorp sleeps (no AI calls) between these hours, in your timezone
SLEEP_FROM_HOUR=23
SLEEP_UNTIL_HOUR=7
TZ=Europe/London

# Max thinking moments per day
MAX_TICKS_PER_DAY=40

# Model (leave empty for the default) and thinking effort (low is cheapest)
CREATURE_MODEL=
CREATURE_EFFORT=low

# Set to 1 to run without the AI (random choices), for testing
CREATURE_FAKE=0
